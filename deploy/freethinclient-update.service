[Unit]
Description=FreeThinClient signed release update worker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/freethinclient/current
ExecStart=/usr/bin/python3 -B -m app.updater
TimeoutStartSec=300
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/freethinclient /var/lib/freethinclient /var/lib/freethinclient-update /var/backups/freethinclient
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
