[Unit]
Description=FreeThinClient administration panel
After=network.target

[Service]
Type=simple
User=freethinclient
Group=freethinclient
WorkingDirectory=/opt/freethinclient/current
ExecStart=/usr/bin/python3 -B -m app.server
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/freethinclient
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
